@misc{zhou2026surglat,
  title={SurgLAT: Surgical Latent Attention Tracking for Depth-Aware Robotic Laparoscope Control},
  author={Rulin Zhou# and Qiujie Song# and Yujie Ma# and An Wang and Wanhao Liu and Guoheng Ma and Yidu Wang and Guankun Wang and Xingrong Diao and Jiankun Wang and Chaowei Zhu and Xianming Liu and Hongliang Ren*},
  year={2026},
  month={aug},
  journal={arXiv preprint},
  url={https://arxiv.org/abs/2608.07876},
  webpage={https://surglat-home-page.pages.dev/},
  pdf={https://arxiv.org/pdf/2608.07876},
  arxiv={2608.07876},
  preview={SurgLAT/pipeline.png},
  abstract={Autonomous laparoscopic camera control requires continuous understanding of the surgeon's operative intent in dynamic surgical scenes, where the target operative region is not a stable physical object but a latent and temporally evolving attention state. SurgLAT is a causal online framework that combines a frozen DINOv3 encoder, a state-conditioned spatial token mixer, and selective causal latent memory to decode probabilistic attention heatmaps and operative regions for downstream endoscope guidance. It further integrates depth-aware scale regulation with Remote Center of Motion constrained control and redundancy-aware null-space initialization. Experiments on real laparoscopic videos and a physical robotic laparoscope platform demonstrate robust online tracking and stable autonomous camera adjustment under occlusion, rapid motion, and target transitions.},
  keywords={Medical Robotics, Surgical Attention Tracking, Autonomous Laparoscope Control}
}

@misc{zhou2026surguniworld,
  selected={true},
  title={Surg-UniWorld: A Unified Surgical World Model with Multimodal Control Experts},
  author={Rulin Zhou# and Wanhao Liu# and Guoheng Ma and Liangjin Shao and Qiujie Song and Yidu Wang and Guankun Wang and Tong Chen and Long Bai and Luping Zhou and Hongliang Ren*},
  year={2026},
  month={aug},
  journal={arXiv preprint},
  url={https://arxiv.org/abs/2608.06770},
  webpage={https://surg-uniworld.pages.dev/},
  pdf={https://arxiv.org/pdf/2608.06770},
  arxiv={2608.06770},
  video={https://surg-uniworld.pages.dev/videos/control-modalities-model-comparison.mp4},
  poster={Surg-UniWorld/poster.png},
  abstract={Controllable surgical world models can provide a generative foundation for surgical artificial intelligence and simulation by synthesizing realistic instrument-tissue interactions. Surg-UniWorld introduces a Hierarchical Surgical Anchor, Anchor-Relative Modality Experts, and a Multimodal Control Expert to support coherent video generation under arbitrary combinations of edge, depth, and optical-flow controls. Experiments demonstrate improved generation quality, temporal consistency, and multimodal controllability.},
  keywords={Medical Robotics, World Models, Surgical Video Generation}
}

@misc{pan2026ncgr,
  selected={true},
  title={NCGR: Noise-Conditional Gated Rectification for Camera Extrinsic Perturbations in BEV 3D Object Detection},
  author={Wenbin Pan# and Wanhao Liu# and Liwei Luo and Panshuo Li* and Yong Xu and Renquan Lu},
  year={2026},
  month={aug},
  journal={arXiv preprint},
  url={https://arxiv.org/abs/2608.03895},
  pdf={https://arxiv.org/pdf/2608.03895},
  arxiv={2608.03895},
  preview={NCGR/pipeline.png},
  abstract={Camera-based bird's-eye-view 3D detection typically assumes accurate and fixed camera extrinsics. NCGR compensates for projection errors with a gated query-camera-specific rectification offset inside spatial cross-attention, while transitioning from perturbation-derived controls during training to a learned camera-level signal for blind inference. Experiments on nuScenes show substantially improved robustness under dynamic and static extrinsic perturbations.},
  keywords={3D Detection, BEV Perception, Robust Perception}
}

@misc{liu2026crossscope,
  selected={true},
  title={CrossScope: A Role-Asymmetric World Model for Joint Dual-Scope Surgical Video Prediction},
  author={Wanhao Liu# and Jinsong Lin# and Rulin Zhou# and Chi Kit Ng# and Wenbin Pan and Zhiqing Tang and Dongyue Li and Liwei Luo and Yanshen Wu and Panshuo Li and Zhiyong Xiong and Huxin Gao and Tamas Haidegger and Hongliang Ren*},
  year={2026},
  month={aug},
  journal={arXiv preprint},
  url={https://arxiv.org/abs/2608.03211},
  webpage={https://wanhao-liu.github.io/CrossScope/},
  pdf={https://arxiv.org/pdf/2608.03211},
  arxiv={2608.03211},
  video={https://wanhao-liu.github.io/CrossScope/static/videos/final_en_subtitled_compact.mp4},
  poster={CrossScope/pipeline.png},
  abstract={CrossScope studies role-asymmetric future prediction for Mother-Child endoscopic retrograde cholangiopancreatography, where two independently moving scopes provide complementary views without calibrated stereo geometry. Its dual-stream world model preserves view-specific experts and routes cross-view evidence according to target-specific spatial requirements, improving visual fidelity, structural preservation, target localization, and motion consistency.},
  keywords={Medical Robotics, World Models, Surgical Video Prediction}
}

@misc{lin2026endowam,
  selected={true},
  title={EndoWAM: A Grounded World-Action Model for Generalizable Endoscopic Navigation},
  author={Jinsong Lin# and Zikang Pan# and Wanhao Liu# and Chi Kit Ng# and Liangjing Shao and Zihang Yu and Ziyu Wang and Yin Wang and Jiaxi Wang and Jeremy Yuen-Chun Teoh and Zhiyong Xiong and Huxin Gao and Hongliang Ren*},
  year={2026},
  month={aug},
  journal={arXiv preprint},
  url={https://arxiv.org/abs/2608.01221},
  webpage={https://jinsonglin-cuhk.github.io/renlab-project-homepages/EndoWAM/#viewpoint-invariance},
  pdf={https://arxiv.org/pdf/2608.01221},
  arxiv={2608.01221},
  preview={EndoWAM/pipeline.png},
  abstract={EndoWAM is a grounded World-Action Model for generalizable robotic endoscopic navigation. It predicts task-relevant target regions in future observations and couples a lightweight diffusion transformer with a discrete action expert through a shared predictive representation. The model enables real-time control and generalizes to unseen viewpoints, environments, and targets across multiple endoscopic procedures.},
  keywords={Medical Robotics, World-Action Models, Endoscopic Navigation}
}

